{
  "name": "pandaclient",
  "productName": "PandaClient",
  "version": "0.17.2",
  "description": "A simple, clean Minecraft Java launcher.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --tsconfig tests/tsconfig.json tests/services.test.mts && tsx --tsconfig tests/tsconfig.json tests/importer.test.mts && tsx --tsconfig tests/tsconfig.json tests/sync.test.mts",
    "test:live": "tsx --tsconfig tests/tsconfig.json tests/live.test.mts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "test:launch": "tsx --tsconfig tests/tsconfig.json tests/launch.test.mts",
    "test:real": "tsx --tsconfig tests/tsconfig.json tests/real-command.check.mts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.81.0",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview3d": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "msmc": "^5.0.5"
  },
  "author": "PandaClient"
}
